# ── Salesperson login (required for the login page) ─────────────────
SALES_EMAIL=sales@carewellaviation.com
SALES_PASSWORD=changeme
SALES_NAME=Sales Executive

# ── AI extraction ────────────────────────────────────────────────────
# OpenRouter is used automatically when this key is set.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Force a specific provider: openrouter | openai | claude | ollama | rule_based
# Leave empty for auto (openrouter if key present, else rule_based).
LLM_PROVIDER=

# ── Supabase (database + auth) ───────────────────────────────────────
# Supabase dashboard → Project Settings → API
# The service-role key bypasses Row Level Security — backend only,
# never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
